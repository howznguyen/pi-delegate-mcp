{
  "name": "pi-delegate-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the pi coding agent as a delegable, steerable worker",
  "type": "module",
  "bin": {
    "pi-delegate-mcp": "dist/index.js",
    "pi-delegate-statusline": "dist/statusline/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./dist/pi/worker.js",
    "./statusline": "./dist/statusline/state.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test:ci": "npm run build && node test/launch.mjs node dist/index.js",
    "test": "for t in guard perm id scope init nopi smoke trace model callback; do echo \"== $t\"; node test/$t.mjs || exit 1; done",
    "prepublishOnly": "npm run test:ci"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "howznguyen <howznguyen@knowns.dev>",
  "license": "MIT",
  "homepage": "https://github.com/howznguyen/pi-delegate-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howznguyen/pi-delegate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/howznguyen/pi-delegate-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "subagent",
    "delegate",
    "claude-code",
    "llm",
    "openrouter",
    "deepseek",
    "grok",
    "codex"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
